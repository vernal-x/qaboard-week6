# 컴포넌트 테스트는 로컬 .env.local의 VITE_DATA_SOURCE 값과 무관하게 항상 mock을 사용해야
# 결정적으로 동작한다(Vite는 test 모드에서 .env, .env.local, .env.test, .env.test.local 순으로
# 병합하며 이 파일이 .env.local의 값을 덮어쓴다). 실제 키가 아니므로 커밋해도 안전하다.
VITE_DATA_SOURCE=mock
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=test-placeholder-key
